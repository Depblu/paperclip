# Paperclip API 地址（Sidecar 用于调用 REST API）
PAPERCLIP_BASE_URL=http://localhost:3100

# Paperclip 页面地址（飞书卡片中的链接，应为飞书用户设备可访问的地址）
# localhost 通常只能本机访问；若飞书用户在远端，需填写公网或局域网地址
PAPERCLIP_PUBLIC_URL=http://localhost:3100

# Board API Key，格式 pcp_board_...
PAPERCLIP_API_KEY=REPLACE_WITH_PAPERCLIP_BOARD_API_KEY

# 飞书应用凭证
FEISHU_APP_ID=REPLACE_WITH_FEISHU_APP_ID
FEISHU_APP_SECRET=REPLACE_WITH_FEISHU_APP_SECRET

# Company 路由配置文件路径
BRIDGE_COMPANIES_CONFIG=./config/companies.local.json

# SQLite 存储路径
SQLITE_PATH=./data/bridge.db

# 轮询周期（毫秒）
POLL_INTERVAL_MS=5000

# 对账周期（毫秒）
RECONCILIATION_INTERVAL_MS=60000

# 扫描并发数
SCAN_CONCURRENCY=4

# 请求超时（毫秒）
REQUEST_TIMEOUT_MS=10000

# 动作凭证有效期（毫秒，默认 24 小时）
ACTION_TOKEN_TTL_MS=86400000

# 日志级别: debug | info | warn | error
LOG_LEVEL=debug

# 管理界面端口
ADMIN_PORT=9090
